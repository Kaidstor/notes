{
  "name": "notes-kai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"bun run dev:server\" \"vite\"",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && bun run build:vendor && bun run build:server",
    "build:vendor": "bun build src/web/mermaid.ts --target browser --format esm --minify --splitting --outdir dist/web/vendor",
    "build:server": "bun build src/server/index.ts --target bun --minify --outfile dist/server.js",
    "start": "bun src/server/index.ts",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.9.10",
    "lucide-react": "^1.23.0",
    "marked": "^15.0.12",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
