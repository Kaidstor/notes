# Токены доступа. Обязательны при NODE_ENV=production, иначе сервер не стартует;
# без них локально доступ открыт всем. Принимаются как Bearer и как cookie notes_token.
# Всё: чтение, правка и удаление любых заметок, полный индекс
NOTES_ADMIN_TOKEN=
# Чтение любой заметки, публикация и правка только своих
NOTES_READ_TOKEN=

# Необязательное
# PORT=3000
# NOTES_DB=./data/notes.db
# NOTES_SITE_NAME=notes.kaidstor.ru
# NOTES_PUBLIC_URL=https://notes.kaidstor.ru
